---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { languages, useTranslations, getLocalizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  currentPath?: string;
}

const { lang, title, description, currentPath = '' } = Astro.props;
const t = useTranslations(lang);

const SITE_ORIGIN = 'https://mkvtomp4.github.io';
const pageTitle = title || t('site.title');
const pageDesc = description || t('site.description');
const localizedPath = getLocalizedPath(lang, currentPath);
const canonicalURL = new URL(localizedPath, SITE_ORIGIN).href;
const ogImageURL = new URL('/og-cover.svg', SITE_ORIGIN).href;

// 100% Google Rich Results Compliant JSON-LD Graph (Zero Fake Ratings/Reviews)
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonicalURL}#webapp`,
      name: t('nav.brand'),
      headline: t('hero.h1'),
      url: canonicalURL,
      description: pageDesc,
      inLanguage: lang,
      applicationCategory: 'MultimediaApplication, UtilitiesApplication',
      operatingSystem: 'Windows, macOS, Linux, iOS, Android',
      browserRequirements: 'Requires HTML5 and WebAssembly support',
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      featureList: [
        'Instant 2-Second Lossless MKV to MP4 Remux (-c copy)',
        'Universal H.264 + AAC Video Transcoding for Mac QuickTime & Smart TVs',
        '100% Client-Side Local Browser RAM Execution via FFmpeg.wasm',
        'MP4 to MKV, WebM to MP4, MKV to AVI, and MKV to MP3 Conversion',
        'Offline-Capable Progressive Web App (PWA)',
      ],
    },
    {
      '@type': 'HowTo',
      '@id': `${canonicalURL}#howto`,
      name: t('howto.title'),
      description: t('howto.subtitle'),
      totalTime: 'PT2S',
      tool: [
        {
          '@type': 'HowToTool',
          name: 'MKVtoMP4 Browser WebAssembly Engine (@ffmpeg/ffmpeg)',
        },
      ],
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t('howto.step1.title'),
          text: t('howto.step1.desc'),
          url: `${canonicalURL}#step-1-dropzone`,
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t('howto.step2.title'),
          text: t('howto.step2.desc'),
          url: `${canonicalURL}#step-2-settings`,
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t('howto.step3.title'),
          text: t('howto.step3.desc'),
          url: `${canonicalURL}#step-4-result`,
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t('breadcrumb.home'),
          item: `${SITE_ORIGIN}${getLocalizedPath(lang, '')}`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t('breadcrumb.converter'),
          item: canonicalURL,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalURL}#faq`,
      mainEntity: (['1', '2', '3', '4', '5', '6', '7', '8'] as const).map((n) => ({
        '@type': 'Question',
        name: t(`faq.q${n}`),
        acceptedAnswer: {
          '@type': 'Answer',
          text: t(`faq.a${n}`),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang} dir={languages[lang].dir}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HF064GDFDW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HF064GDFDW');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Self-Referencing Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Bidirectional 8-Locale Hreflang Matrix + x-default -->
    {
      Object.keys(languages).map((code) => {
        const href = new URL(getLocalizedPath(code as Lang, currentPath), SITE_ORIGIN).href;
        return <link rel="alternate" hreflang={code} href={href} />;
      })
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getLocalizedPath('en', currentPath), SITE_ORIGIN).href}
    />

    <!-- Favicon & Offline PWA Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#3A86FF" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="MKVtoMP4" />

    <!-- Open Graph / Facebook / Discord -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MKVtoMP4" />
    <meta property="og:locale" content={languages[lang].localeCode} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('hero.h1')} />

    <!-- Twitter / X Summary Large Image Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Structured Data (WebApplication, HowTo, BreadcrumbList, FAQPage) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

    <!-- Prevent Flash of Incorrect Theme (Default Light Mode #FFF4F4) -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('mkvtomp4-theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- COI & Offline Service Worker Registration for SharedArrayBuffer + 100% Offline PWA -->
    <script src="/coi-serviceworker.js" is:inline></script>
  </head>
  <body class="min-h-screen bg-bgPrimary text-textPrimary antialiased selection:bg-azure selection:text-white">
    <Header lang={lang} currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <footer class="border-t border-borderTheme bg-bgSurface py-10 text-sm text-textSecondary">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:px-6 lg:px-8">
        <div class="flex flex-col items-center gap-1 sm:items-start">
          <span class="font-display text-lg font-extrabold text-textPrimary">
            MKV<span class="text-azure">to</span>MP4.github.io
          </span>
          <p class="text-xs text-textSecondary">
            © 2026 Kishara Dilshan / PixelPieStudio • MIT License • 100% Local Browser RAM Processing
          </p>
        </div>

        <nav aria-label={t('nav.language.aria')} class="flex flex-wrap items-center justify-center gap-2">
          {
            Object.entries(languages).map(([code, info]) => (
              <a
                href={getLocalizedPath(code as Lang, currentPath)}
                class:list={[
                  'rounded-lg px-2.5 py-1 text-xs font-bold transition',
                  code === lang
                    ? 'bg-azure text-white'
                    : 'border border-borderTheme bg-bgWorkspace text-textPrimary hover:border-azure',
                ]}
              >
                {info.flag} {info.nativeName}
              </a>
            ))
          }
        </nav>

        <a
          href="https://ko-fi.com/kishara"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t('nav.support.aria')}
          class="kofi-cta-btn inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-extrabold text-white"
        >
          <span aria-hidden="true">❤️</span>
          <span>{t('nav.support.label')}</span>
        </a>
      </div>
    </footer>
  </body>
</html>
