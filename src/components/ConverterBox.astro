---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  defaultMode?: 'mkv-mp4' | 'mp4-mkv' | 'webm-mp4' | 'mkv-avi' | 'mkv-mp3';
  customH1?: string;
}

const { lang, defaultMode = 'mkv-mp4', customH1 } = Astro.props;
const t = useTranslations(lang);

const modes = [
  { id: 'mkv-mp4', label: t('mode.mkv_mp4'), inExt: 'MKV', outExt: 'mp4', mime: 'video/mp4', accept: '.mkv,video/x-matroska,video/*' },
  { id: 'mp4-mkv', label: t('mode.mp4_mkv'), inExt: 'MP4', outExt: 'mkv', mime: 'video/x-matroska', accept: '.mp4,video/mp4,video/*' },
  { id: 'webm-mp4', label: t('mode.webm_mp4'), inExt: 'WebM', outExt: 'mp4', mime: 'video/mp4', accept: '.webm,video/webm,video/*' },
  { id: 'mkv-avi', label: t('mode.mkv_avi'), inExt: 'MKV', outExt: 'avi', mime: 'video/x-msvideo', accept: '.mkv,video/x-matroska,video/*' },
  { id: 'mkv-mp3', label: t('mode.mkv_mp3'), inExt: 'MKV', outExt: 'mp3', mime: 'audio/mpeg', accept: '.mkv,video/x-matroska,video/*' },
] as const;
---

<section
  id="converter-hero-fold"
  class="relative flex min-h-[calc(100dvh-4rem)] w-full flex-col items-center justify-center px-3 py-4 sm:px-6 lg:px-8"
>
  <div class="mx-auto flex w-full max-w-5xl flex-col items-center">
    <!-- Primary H1 Above the Fold -->
    <div class="mb-4 text-center sm:mb-6">
      <h1 class="font-display font-extrabold tracking-tight text-textPrimary">
        {customH1 || t('hero.h1')}
      </h1>
      <p class="mt-2 max-w-3xl text-base font-medium text-textSecondary sm:text-lg">
        {t('hero.subtitle')}
      </p>
    </div>

    <!-- Interactive Converter Box Div -->
    <div
      id="converter-workspace-box"
      data-default-mode={defaultMode}
      data-i18n={JSON.stringify({
        dropTitle: t('drop.title'),
        selectBtn: t('drop.button.select'),
        initializing: t('progress.initializing'),
        remuxing: t('progress.remuxing'),
        transcoding: t('progress.transcoding'),
        fallbackNotice: t('progress.fallback_notice'),
        downloadMp4: t('result.download.btn'),
        downloadGeneric: t('result.download.generic'),
        modeRemux: t('result.mode.remux'),
        modeTranscode: t('result.mode.transcode'),
      })}
      class="w-full rounded-[2rem] border-2 border-borderTheme bg-bgWorkspace p-4 shadow-workspace transition-all duration-300 sm:p-7"
    >
      <!-- Top Mode Selector Pills -->
      <div
        role="tablist"
        aria-label={t('mode.aria.group')}
        class="mb-5 flex flex-wrap items-center justify-center gap-2 sm:gap-2.5"
      >
        {
          modes.map((m) => {
            const isActive = m.id === defaultMode;
            return (
              <button
                type="button"
                role="tab"
                aria-selected={isActive ? 'true' : 'false'}
                aria-label={m.label}
                data-mode-pill={m.id}
                data-in-ext={m.inExt}
                data-out-ext={m.outExt}
                data-mime={m.mime}
                data-accept={m.accept}
                class:list={[
                  'mode-pill-btn flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm sm:text-base font-extrabold tracking-tight transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-azure',
                  isActive
                    ? 'border-2 border-azure bg-azure text-white shadow-md scale-[1.02] hover:bg-azure-hover hover:text-white'
                    : 'border-2 border-borderTheme bg-bgSurface text-textPrimary hover:border-azure hover:bg-pillBadge hover:text-textPrimary',
                ]}
              >
                <span>{m.label}</span>
              </button>
            );
          })
        }
      </div>

      <!-- STEP 1: Giant Dashed Dropzone -->
      <div id="step-1-dropzone" class="w-full">
        <div
          id="dropzone-interactive"
          tabindex="0"
          role="button"
          aria-label={t('drop.button.select')}
          class="dropzone-area group relative flex flex-col items-center justify-center rounded-3xl px-4 py-8 text-center sm:px-8 sm:py-11 cursor-pointer focus:outline-none focus:ring-4 focus:ring-azure/40"
        >
          <input
            type="file"
            id="file-input-hidden"
            multiple
            accept=".mkv,.mp4,.webm,.avi,.mov,video/*,audio/*"
            class="sr-only"
          />

          <!-- Floating Oversized SVG Icon (64px) -->
          <div
            class="animate-float-slow mb-4 flex h-16 w-16 sm:h-20 sm:w-20 items-center justify-center rounded-3xl bg-pillBadge text-azure shadow-inner transition-transform duration-300 group-hover:scale-110"
          >
            <svg
              class="h-14 w-14 sm:h-16 sm:w-16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <path d="M12 18v-6"></path>
              <path d="M9.5 14.5 12 12l2.5 2.5"></path>
            </svg>
          </div>

          <h2
            id="dropzone-heading"
            class="font-display text-xl font-extrabold text-textPrimary sm:text-2xl md:text-3xl"
          >
            {t('drop.title')}
          </h2>

          <p class="mt-2 max-w-xl text-sm font-medium text-textSecondary sm:text-base">
            {t('drop.subtitle')}
          </p>

          <!-- Primary Action Buttons inside Dropzone -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
            <button
              type="button"
              id="select-video-btn"
              class="btn-azure-primary flex items-center gap-3 rounded-2xl px-7 py-4 text-lg font-extrabold tracking-tight sm:px-9 sm:py-4 sm:text-xl"
            >
              <svg
                class="h-6 w-6 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span id="select-video-btn-label">{t('drop.button.select')}</span>
            </button>

            <button
              type="button"
              id="try-sample-btn"
              class="flex items-center gap-2.5 rounded-2xl border-2 border-borderTheme bg-bgSurface px-5 py-4 text-base font-bold text-textPrimary transition-all duration-200 hover:border-azure hover:bg-pillBadge focus:outline-none focus:ring-2 focus:ring-azure"
            >
              <svg
                class="h-5 w-5 text-azure"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span>{t('drop.button.sample')}</span>
            </button>
          </div>

          <!-- Highlight Pill Badge -->
          <div class="mt-5 inline-flex items-center gap-2 rounded-full bg-pillBadge px-4 py-1.5 text-xs font-bold text-textPrimary sm:text-sm">
            <span class="h-2.5 w-2.5 rounded-full bg-azure animate-pulse"></span>
            <span>{t('drop.batch.hint')}</span>
          </div>
        </div>
      </div>

      <!-- STEP 2: Smart Settings & Batch Queue -->
      <div id="step-2-settings" class="hidden w-full space-y-5">
        <!-- Queued Files Header & List -->
        <div class="rounded-2xl border-2 border-borderTheme bg-bgSurface p-4 sm:p-5">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-borderTheme pb-3">
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-azure text-sm font-extrabold text-white" id="queue-count-badge">1</span>
              <h3 class="font-display text-lg font-extrabold text-textPrimary">
                {t('drop.queue.title')}
              </h3>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="queue-add-more-btn"
                class="rounded-xl border border-borderTheme bg-bgWorkspace px-3 py-1.5 text-xs font-bold text-textPrimary transition hover:border-azure hover:text-azure sm:text-sm"
              >
                {t('drop.queue.add_more')}
              </button>
              <button
                type="button"
                id="queue-clear-btn"
                class="rounded-xl border border-borderTheme bg-bgWorkspace px-3 py-1.5 text-xs font-bold text-rose-500 transition hover:border-rose-500 sm:text-sm"
              >
                {t('drop.queue.clear')}
              </button>
            </div>
          </div>

          <ul id="file-queue-list" class="mt-3 max-h-40 space-y-2 overflow-y-auto pr-1"></ul>
        </div>

        <!-- Big Clear Toggle Cards: Remux vs Transcode -->
        <div>
          <h3 class="mb-3 font-display text-base font-extrabold uppercase tracking-wider text-textSecondary">
            {t('settings.title')}
          </h3>
          <div class="grid grid-cols-1 gap-3.5 md:grid-cols-2">
            <!-- Card 1: Superfast Lossless Remux (Recommended) -->
            <label
              id="card-mode-remux"
              class="relative flex cursor-pointer items-start gap-3.5 rounded-2xl border-2 border-azure bg-pillBadge/40 p-4 transition-all duration-200 hover:border-azure"
            >
              <input
                type="radio"
                name="engine_mode"
                value="remux"
                checked
                class="mt-1 h-5 w-5 accent-azure"
              />
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="font-display text-base font-extrabold text-textPrimary sm:text-lg">
                    {t('settings.remux.title')}
                  </span>
                </div>
                <p class="mt-1 text-sm text-textSecondary">
                  {t('settings.remux.desc')}
                </p>
              </div>
            </label>

            <!-- Card 2: Full Compatibility Transcode (H.264/AAC) -->
            <label
              id="card-mode-transcode"
              class="relative flex cursor-pointer items-start gap-3.5 rounded-2xl border-2 border-borderTheme bg-bgSurface p-4 transition-all duration-200 hover:border-azure"
            >
              <input
                type="radio"
                name="engine_mode"
                value="transcode"
                class="mt-1 h-5 w-5 accent-azure"
              />
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="font-display text-base font-extrabold text-textPrimary sm:text-lg">
                    {t('settings.transcode.title')}
                  </span>
                </div>
                <p class="mt-1 text-sm text-textSecondary">
                  {t('settings.transcode.desc')}
                </p>
              </div>
            </label>
          </div>
        </div>

        <!-- Audio Track & Subtitle Handling Pills -->
        <div class="grid grid-cols-1 gap-4 rounded-2xl border border-borderTheme bg-bgSurface p-4 sm:grid-cols-2">
          <!-- Audio Handling -->
          <div>
            <span class="block text-xs font-extrabold uppercase tracking-wider text-textSecondary">
              {t('settings.audio.label')}
            </span>
            <div class="mt-2 flex flex-wrap gap-2" id="audio-pills-group">
              <button
                type="button"
                data-audio-mode="copy_aac"
                class="audio-pill rounded-xl bg-azure px-3 py-1.5 text-xs font-bold text-white transition sm:text-sm"
              >
                {t('settings.audio.copy_aac')}
              </button>
              <button
                type="button"
                data-audio-mode="copy_exact"
                class="audio-pill rounded-xl border border-borderTheme bg-bgWorkspace px-3 py-1.5 text-xs font-bold text-textPrimary transition hover:border-azure sm:text-sm"
              >
                {t('settings.audio.copy_exact')}
              </button>
              <button
                type="button"
                data-audio-mode="normalize"
                class="audio-pill rounded-xl border border-borderTheme bg-bgWorkspace px-3 py-1.5 text-xs font-bold text-textPrimary transition hover:border-azure sm:text-sm"
              >
                {t('settings.audio.normalize')}
              </button>
            </div>
          </div>

          <!-- Subtitle Handling -->
          <div>
            <span class="block text-xs font-extrabold uppercase tracking-wider text-textSecondary">
              {t('settings.subtitles.label')}
            </span>
            <div class="mt-2 flex flex-wrap gap-2" id="subtitle-pills-group">
              <button
                type="button"
                data-sub-mode="mov_text"
                class="sub-pill rounded-xl bg-azure px-3 py-1.5 text-xs font-bold text-white transition sm:text-sm"
              >
                {t('settings.subtitles.mov_text')}
              </button>
              <button
                type="button"
                data-sub-mode="strip"
                class="sub-pill rounded-xl border border-borderTheme bg-bgWorkspace px-3 py-1.5 text-xs font-bold text-textPrimary transition hover:border-azure sm:text-sm"
              >
                {t('settings.subtitles.strip')}
              </button>
            </div>
          </div>
        </div>

        <!-- Massive Start Conversion CTA Button -->
        <div class="flex justify-center pt-1">
          <button
            type="button"
            id="start-conversion-btn"
            class="btn-azure-primary flex w-full sm:w-auto min-w-[280px] items-center justify-center gap-3 rounded-2xl px-10 py-4 text-xl font-extrabold tracking-tight"
          >
            <svg
              class="h-7 w-7 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>{t('settings.start.btn')}</span>
          </button>
        </div>
      </div>

      <!-- STEP 3: Smooth Animated Progress Bar -->
      <div id="step-3-progress" aria-live="polite" aria-atomic="false" class="hidden w-full py-6 text-center">
        <!-- Blush Rose Pink (#FFD6E0) Privacy Badge -->
        <div class="mb-5 inline-flex items-center gap-2 rounded-full bg-pillBadge px-5 py-2 text-sm font-extrabold text-textPrimary shadow-sm">
          <svg
            class="h-5 w-5 text-azure"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>{t('progress.badge')}</span>
        </div>

        <h3
          id="progress-status-text"
          class="font-display text-2xl font-extrabold text-textPrimary sm:text-3xl"
        >
          {t('progress.remuxing')}
        </h3>

        <p id="progress-filename-text" class="mt-1 font-mono text-sm text-textSecondary"></p>

        <!-- Big Percentage & Animated Gradient Bar -->
        <div class="mx-auto mt-6 max-w-2xl">
          <div class="mb-2 flex items-end justify-between px-1">
            <span
              id="progress-percent-number"
              class="font-display text-4xl font-extrabold text-azure"
            >
              0%
            </span>
            <div class="flex items-center gap-4 text-xs font-bold uppercase tracking-wider text-textSecondary sm:text-sm">
              <span>
                {t('progress.speed')}: <strong id="progress-speed-val" class="text-textPrimary">Instant</strong>
              </span>
              <span>
                {t('progress.elapsed')}: <strong id="progress-elapsed-val" class="text-textPrimary">0.0s</strong>
              </span>
            </div>
          </div>

          <div class="h-6 w-full overflow-hidden rounded-2xl border-2 border-borderTheme bg-bgSurface p-0.5">
            <div
              id="progress-bar-fill"
              class="progress-gradient-bar h-full rounded-xl transition-all duration-200"
              style="width: 6%;"
            ></div>
          </div>
        </div>

        <!-- Live FFmpeg Console Log Snippet -->
        <div class="mx-auto mt-4 max-w-2xl rounded-xl border border-borderTheme bg-bgSurface px-4 py-2 text-left">
          <code id="ffmpeg-live-log" class="block truncate font-mono text-xs text-textSecondary">
            ffmpeg -i input.mkv -c copy -movflags +faststart output.mp4
          </code>
        </div>
      </div>

      <!-- STEP 4: Instant HTML5 Video Preview & Download -->
      <div id="step-4-result" class="hidden w-full space-y-5">
        <div class="flex flex-col items-center text-center">
          <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-emerald-500/15 px-4 py-1 text-sm font-extrabold text-emerald-600 dark:text-emerald-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t('result.title')}</span>
          </div>
          <p class="text-sm font-medium text-textSecondary sm:text-base">
            {t('result.subtitle')}
          </p>
        </div>

        <!-- Instant HTML5 <video controls> Preview Player -->
        <div class="mx-auto max-w-3xl overflow-hidden rounded-3xl border-2 border-borderTheme bg-black shadow-lg">
          <video
            id="result-video-preview"
            controls
            playsinline
            aria-label={t('result.video.aria')}
            class="max-h-[340px] w-full object-contain"
          ></video>
          <audio
            id="result-audio-preview"
            controls
            aria-label={t('result.audio.aria')}
            class="hidden w-full p-6"
          ></audio>
        </div>

        <!-- Conversion Telemetry Summary -->
        <div class="mx-auto grid max-w-3xl grid-cols-2 gap-2.5 sm:grid-cols-4">
          <div class="rounded-2xl border border-borderTheme bg-bgSurface p-3 text-center">
            <span class="block text-xs font-bold uppercase text-textSecondary">{t('result.stats.original')}</span>
            <strong id="stat-original-size" class="mt-0.5 block truncate text-sm font-extrabold text-textPrimary">—</strong>
          </div>
          <div class="rounded-2xl border border-borderTheme bg-bgSurface p-3 text-center">
            <span class="block text-xs font-bold uppercase text-textSecondary">{t('result.stats.output')}</span>
            <strong id="stat-output-size" class="mt-0.5 block truncate text-sm font-extrabold text-azure">—</strong>
          </div>
          <div class="rounded-2xl border border-borderTheme bg-bgSurface p-3 text-center">
            <span class="block text-xs font-bold uppercase text-textSecondary">{t('result.stats.time')}</span>
            <strong id="stat-elapsed-time" class="mt-0.5 block text-sm font-extrabold text-textPrimary">—</strong>
          </div>
          <div class="rounded-2xl border border-borderTheme bg-bgSurface p-3 text-center">
            <span class="block text-xs font-bold uppercase text-textSecondary">{t('result.stats.mode')}</span>
            <strong id="stat-engine-mode" class="mt-0.5 block truncate text-sm font-extrabold text-textPrimary">—</strong>
          </div>
        </div>

        <!-- Batch Output Download List (shown when >1 file converted) -->
        <div id="batch-results-container" class="hidden mx-auto max-w-3xl rounded-2xl border border-borderTheme bg-bgSurface p-4">
          <ul id="batch-results-list" class="space-y-2"></ul>
        </div>

        <!-- Oversized Download MP4 & Convert Another Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-4 pt-1">
          <a
            id="download-result-link"
            href="#"
            download="converted.mp4"
            class="btn-azure-primary flex items-center gap-3 rounded-2xl px-9 py-4 text-xl font-extrabold tracking-tight"
          >
            <svg
              class="h-7 w-7 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span id="download-result-label">{t('result.download.btn')}</span>
          </a>

          <button
            type="button"
            id="convert-another-btn"
            class="flex items-center gap-2.5 rounded-2xl border-2 border-borderTheme bg-bgSurface px-6 py-4 text-base font-extrabold text-textPrimary transition hover:border-azure hover:bg-pillBadge"
          >
            <svg
              class="h-5 w-5 text-azure"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="1 4 1 10 7 10"></polyline>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
            <span>{t('result.reset.btn')}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { FFmpeg } from '@ffmpeg/ffmpeg';
  import { fetchFile, toBlobURL } from '@ffmpeg/util';

  interface QueuedVideo {
    file: File;
    id: string;
  }

  interface ConvertedOutput {
    name: string;
    url: string;
    size: number;
    originalName: string;
    originalSize: number;
    mime: string;
    usedMode: string;
  }

  const workspaceBox = document.getElementById('converter-workspace-box');
  if (workspaceBox) {
    const i18n = JSON.parse(workspaceBox.getAttribute('data-i18n') || '{}');

    // Mode State
    let currentFormatMode = workspaceBox.getAttribute('data-default-mode') || 'mkv-mp4';
    let currentOutExt = 'mp4';
    let currentMime = 'video/mp4';
    let audioHandling = 'copy_aac';
    let subtitleHandling = 'mov_text';

    // Queue State
    let fileQueue: QueuedVideo[] = [];
    let convertedOutputs: ConvertedOutput[] = [];
    let ffmpegInstance: FFmpeg | null = null;
    let isEngineLoaded = false;

    // Elements
    const modePills = document.querySelectorAll<HTMLButtonElement>('[data-mode-pill]');
    const step1 = document.getElementById('step-1-dropzone')!;
    const step2 = document.getElementById('step-2-settings')!;
    const step3 = document.getElementById('step-3-progress')!;
    const step4 = document.getElementById('step-4-result')!;

    const dropzoneArea = document.getElementById('dropzone-interactive')!;
    const fileInput = document.getElementById('file-input-hidden') as HTMLInputElement;
    const selectVideoBtn = document.getElementById('select-video-btn')!;
    const trySampleBtn = document.getElementById('try-sample-btn')!;
    const queueListEl = document.getElementById('file-queue-list')!;
    const queueCountBadge = document.getElementById('queue-count-badge')!;
    const addMoreBtn = document.getElementById('queue-add-more-btn')!;
    const clearQueueBtn = document.getElementById('queue-clear-btn')!;
    const startBtn = document.getElementById('start-conversion-btn')!;

    const cardRemux = document.getElementById('card-mode-remux')!;
    const cardTranscode = document.getElementById('card-mode-transcode')!;
    const engineRadios = document.querySelectorAll<HTMLInputElement>('input[name="engine_mode"]');
    const audioPills = document.querySelectorAll<HTMLButtonElement>('.audio-pill');
    const subPills = document.querySelectorAll<HTMLButtonElement>('.sub-pill');

    const progressStatusText = document.getElementById('progress-status-text')!;
    const progressFilenameText = document.getElementById('progress-filename-text')!;
    const progressPercentNumber = document.getElementById('progress-percent-number')!;
    const progressSpeedVal = document.getElementById('progress-speed-val')!;
    const progressElapsedVal = document.getElementById('progress-elapsed-val')!;
    const progressBarFill = document.getElementById('progress-bar-fill')!;
    const ffmpegLiveLog = document.getElementById('ffmpeg-live-log')!;

    const videoPreview = document.getElementById('result-video-preview') as HTMLVideoElement;
    const audioPreview = document.getElementById('result-audio-preview') as HTMLAudioElement;
    const downloadLink = document.getElementById('download-result-link') as HTMLAnchorElement;
    const downloadLabel = document.getElementById('download-result-label')!;
    const convertAnotherBtn = document.getElementById('convert-another-btn')!;
    const batchResultsContainer = document.getElementById('batch-results-container')!;
    const batchResultsList = document.getElementById('batch-results-list')!;

    const statOrigSize = document.getElementById('stat-original-size')!;
    const statOutSize = document.getElementById('stat-output-size')!;
    const statElapsed = document.getElementById('stat-elapsed-time')!;
    const statEngineMode = document.getElementById('stat-engine-mode')!;

    function formatBytes(bytes: number): string {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return `${(bytes / Math.pow(k, i)).toFixed(i > 1 ? 2 : 1)} ${sizes[i]}`;
    }

    function showStep(stepNumber: 1 | 2 | 3 | 4) {
      step1.classList.toggle('hidden', stepNumber !== 1);
      step2.classList.toggle('hidden', stepNumber !== 2);
      step3.classList.toggle('hidden', stepNumber !== 3);
      step4.classList.toggle('hidden', stepNumber !== 4);
    }

    // Mode Selector Pills Handler
    const BASE_PILL_CLASSES =
      'mode-pill-btn flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm sm:text-base font-extrabold tracking-tight transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-azure';
    const ACTIVE_PILL_CLASSES =
      'border-2 border-azure bg-azure text-white shadow-md scale-[1.02] hover:bg-azure-hover hover:text-white';
    const INACTIVE_PILL_CLASSES =
      'border-2 border-borderTheme bg-bgSurface text-textPrimary hover:border-azure hover:bg-pillBadge hover:text-textPrimary';

    modePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        modePills.forEach((p) => {
          p.setAttribute('aria-selected', 'false');
          p.className = `${BASE_PILL_CLASSES} ${INACTIVE_PILL_CLASSES}`;
        });
        pill.setAttribute('aria-selected', 'true');
        pill.className = `${BASE_PILL_CLASSES} ${ACTIVE_PILL_CLASSES}`;

        currentFormatMode = pill.getAttribute('data-mode-pill') || 'mkv-mp4';
        currentOutExt = pill.getAttribute('data-out-ext') || 'mp4';
        currentMime = pill.getAttribute('data-mime') || 'video/mp4';
        const acceptAttr = pill.getAttribute('data-accept') || 'video/*';
        fileInput.setAttribute('accept', acceptAttr);

        // Update download label for target extension
        if (currentOutExt === 'mp4') {
          downloadLabel.textContent = i18n.downloadMp4 || 'Download MP4 File';
        } else {
          downloadLabel.textContent = `${i18n.downloadGeneric || 'Download'} (.${currentOutExt.toUpperCase()})`;
        }
      });
    });

    // Engine Mode Radio Cards Styling
    engineRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        const isRemux = radio.value === 'remux' && radio.checked;
        if (isRemux) {
          cardRemux.classList.add('border-azure', 'bg-pillBadge/40');
          cardRemux.classList.remove('border-borderTheme', 'bg-bgSurface');
          cardTranscode.classList.remove('border-azure', 'bg-pillBadge/40');
          cardTranscode.classList.add('border-borderTheme', 'bg-bgSurface');
        } else {
          cardTranscode.classList.add('border-azure', 'bg-pillBadge/40');
          cardTranscode.classList.remove('border-borderTheme', 'bg-bgSurface');
          cardRemux.classList.remove('border-azure', 'bg-pillBadge/40');
          cardRemux.classList.add('border-borderTheme', 'bg-bgSurface');
        }
      });
    });

    // Audio & Subtitle Pill Selection
    audioPills.forEach((btn) => {
      btn.addEventListener('click', () => {
        audioPills.forEach((b) => {
          b.className =
            'audio-pill rounded-xl border border-borderTheme bg-bgWorkspace px-3 py-1.5 text-xs font-bold text-textPrimary transition hover:border-azure sm:text-sm';
        });
        btn.className =
          'audio-pill rounded-xl bg-azure px-3 py-1.5 text-xs font-bold text-white transition sm:text-sm';
        audioHandling = btn.getAttribute('data-audio-mode') || 'copy_aac';
      });
    });

    subPills.forEach((btn) => {
      btn.addEventListener('click', () => {
        subPills.forEach((b) => {
          b.className =
            'sub-pill rounded-xl border border-borderTheme bg-bgWorkspace px-3 py-1.5 text-xs font-bold text-textPrimary transition hover:border-azure sm:text-sm';
        });
        btn.className =
          'sub-pill rounded-xl bg-azure px-3 py-1.5 text-xs font-bold text-white transition sm:text-sm';
        subtitleHandling = btn.getAttribute('data-sub-mode') || 'mov_text';
      });
    });

    // Render Queue List
    function renderQueue() {
      queueCountBadge.textContent = String(fileQueue.length);
      queueListEl.innerHTML = '';

      fileQueue.forEach((item, idx) => {
        const li = document.createElement('li');
        li.className =
          'flex items-center justify-between rounded-xl border border-borderTheme bg-bgWorkspace px-3.5 py-2 text-sm';
        li.innerHTML = `
          <div class="flex items-center gap-2.5 truncate pr-3">
            <span class="font-mono text-xs font-bold text-azure">#${idx + 1}</span>
            <span class="truncate font-semibold text-textPrimary">${item.file.name}</span>
            <span class="shrink-0 rounded-lg bg-pillBadge px-2 py-0.5 text-xs font-bold text-textSecondary">${formatBytes(item.file.size)}</span>
          </div>
          <button type="button" data-remove-id="${item.id}" class="text-xs font-bold text-rose-500 hover:underline">✕</button>
        `;
        queueListEl.appendChild(li);
      });

      queueListEl.querySelectorAll<HTMLButtonElement>('[data-remove-id]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const removeId = btn.getAttribute('data-remove-id');
          fileQueue = fileQueue.filter((f) => f.id !== removeId);
          if (fileQueue.length === 0) {
            showStep(1);
          } else {
            renderQueue();
          }
        });
      });
    }

    function addFilesToQueue(files: FileList | File[]) {
      const arr = Array.from(files);
      if (arr.length === 0) return;
      arr.forEach((file) => {
        fileQueue.push({
          file,
          id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        });
      });
      renderQueue();
      showStep(2);
    }

    // Dropzone Events
    selectVideoBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    dropzoneArea.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#try-sample-btn')) return;
      fileInput.click();
    });

    dropzoneArea.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        addFilesToQueue(fileInput.files);
        fileInput.value = '';
      }
    });

    ['dragenter', 'dragover'].forEach((evt) => {
      dropzoneArea.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzoneArea.classList.add('drag-over');
      });
    });

    ['dragleave', 'drop'].forEach((evt) => {
      dropzoneArea.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzoneArea.classList.remove('drag-over');
      });
    });

    dropzoneArea.addEventListener('drop', (e: DragEvent) => {
      if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
        addFilesToQueue(e.dataTransfer.files);
      }
    });

    addMoreBtn.addEventListener('click', () => fileInput.click());
    clearQueueBtn.addEventListener('click', () => {
      fileQueue = [];
      showStep(1);
    });

    // Generate an authentic in-browser sample MKV video with animated canvas + audio tone
    async function createSampleMkvFile(): Promise<File> {
      const canvas = document.createElement('canvas');
      canvas.width = 640;
      canvas.height = 360;
      const ctx = canvas.getContext('2d')!;

      const stream = canvas.captureStream(30);

      // Add a gentle pleasant audio chime stream using Web Audio API
      try {
        const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(440, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        const dest = audioCtx.createMediaStreamDestination();
        osc.connect(gain);
        gain.connect(dest);
        osc.start();
        setTimeout(() => {
          try {
            osc.stop();
            audioCtx.close();
          } catch {}
        }, 1600);
        dest.stream.getAudioTracks().forEach((track) => stream.addTrack(track));
      } catch {}

      const mimeOptions = [
        'video/x-matroska;codecs=avc1',
        'video/webm;codecs=vp8,opus',
        'video/webm',
        'video/mp4',
      ];
      const chosenMime = mimeOptions.find((m) => MediaRecorder.isTypeSupported(m)) || '';
      const recorder = chosenMime ? new MediaRecorder(stream, { mimeType: chosenMime }) : new MediaRecorder(stream);
      const chunks: BlobPart[] = [];

      recorder.ondataavailable = (e) => {
        if (e.data && e.data.size > 0) chunks.push(e.data);
      };

      const recordingPromise = new Promise<Blob>((resolve) => {
        recorder.onstop = () => {
          resolve(new Blob(chunks, { type: 'video/x-matroska' }));
        };
      });

      recorder.start();

      // Render 48 smooth frames (~1.6 seconds)
      for (let frame = 0; frame < 48; frame++) {
        ctx.fillStyle = '#0F172A';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Animated gradient orb
        const x = 140 + frame * 7.5;
        const grad = ctx.createRadialGradient(x, 180, 15, x, 180, 140);
        grad.addColorStop(0, '#3A86FF');
        grad.addColorStop(0.6, '#BDB2FF');
        grad.addColorStop(1, '#FFD6E0');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(x, 180, 95, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#FFF4F4';
        ctx.font = 'bold 28px sans-serif';
        ctx.fillText('MKVtoMP4 — Sample 720p Stream', 85, 80);
        ctx.font = '20px monospace';
        ctx.fillStyle = '#FFD6E0';
        ctx.fillText(`Frame ${frame + 1}/48 • 100% Local RAM Remux`, 115, 315);

        await new Promise((r) => setTimeout(r, 28));
      }

      recorder.stop();
      stream.getTracks().forEach((t) => t.stop());

      const blob = await recordingPromise;
      return new File([blob], 'sample-obs-recording.mkv', { type: 'video/x-matroska' });
    }

    trySampleBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const origText = trySampleBtn.innerHTML;
      trySampleBtn.setAttribute('disabled', 'true');
      trySampleBtn.textContent = 'Generating Sample MKV...';
      try {
        const sampleFile = await createSampleMkvFile();
        addFilesToQueue([sampleFile]);
      } finally {
        trySampleBtn.removeAttribute('disabled');
        trySampleBtn.innerHTML = origText;
      }
    });

    // Load FFmpeg.wasm Engine
    async function ensureFFmpegLoaded(): Promise<FFmpeg> {
      if (ffmpegInstance && isEngineLoaded) return ffmpegInstance;

      ffmpegInstance = new FFmpeg();
      ffmpegInstance.on('log', ({ message }) => {
        if (message && ffmpegLiveLog) {
          ffmpegLiveLog.textContent = message;
        }
      });

      ffmpegInstance.on('progress', ({ progress }) => {
        const pct = Math.max(5, Math.min(99, Math.round(progress * 100)));
        if (!Number.isNaN(pct)) {
          progressPercentNumber.textContent = `${pct}%`;
          progressBarFill.style.width = `${pct}%`;
        }
      });

      const baseURL = 'https://unpkg.com/@ffmpeg/core@0.12.6/dist/esm';
      await ffmpegInstance.load({
        coreURL: await toBlobURL(`${baseURL}/ffmpeg-core.js`, 'text/javascript'),
        wasmURL: await toBlobURL(`${baseURL}/ffmpeg-core.wasm`, 'application/wasm'),
      });

      isEngineLoaded = true;
      return ffmpegInstance;
    }

    // Build FFmpeg Arguments for Remux (-c copy) vs Transcode (H.264/AAC)
    function buildFFmpegArgs(
      inputName: string,
      outputName: string,
      formatMode: string,
      engineMode: 'remux' | 'transcode'
    ): string[] {
      if (formatMode === 'mkv-mp3') {
        return ['-i', inputName, '-vn', '-c:a', 'libmp3lame', '-q:a', '2', outputName];
      }

      if (engineMode === 'remux') {
        const args = ['-i', inputName, '-c:v', 'copy'];
        if (audioHandling === 'copy_exact') {
          args.push('-c:a', 'copy');
        } else if (audioHandling === 'normalize') {
          args.push('-c:a', 'aac', '-b:a', '192k', '-af', 'loudnorm');
        } else {
          // copy_aac: copy video, encode audio to AAC for universal MP4 safety
          args.push('-c:a', 'aac', '-b:a', '192k');
        }

        if (subtitleHandling === 'strip') {
          args.push('-sn');
        } else if (outputName.endsWith('.mp4')) {
          args.push('-c:s', 'mov_text');
        }

        if (outputName.endsWith('.mp4')) {
          args.push('-movflags', '+faststart');
        }
        args.push(outputName);
        return args;
      }

      // Full Compatibility Transcode (H.264 + AAC)
      const args = [
        '-i',
        inputName,
        '-c:v',
        'libx264',
        '-preset',
        'ultrafast',
        '-crf',
        '23',
        '-pix_fmt',
        'yuv420p',
        '-c:a',
        'aac',
        '-b:a',
        '192k',
      ];
      if (subtitleHandling === 'strip') {
        args.push('-sn');
      }
      if (outputName.endsWith('.mp4')) {
        args.push('-movflags', '+faststart');
      }
      args.push(outputName);
      return args;
    }

    // Execute Conversion
    startBtn.addEventListener('click', async () => {
      if (fileQueue.length === 0) return;

      const selectedRadio = document.querySelector<HTMLInputElement>('input[name="engine_mode"]:checked');
      const requestedEngineMode: 'remux' | 'transcode' =
        selectedRadio?.value === 'transcode' ? 'transcode' : 'remux';

      showStep(3);
      convertedOutputs = [];
      progressPercentNumber.textContent = '8%';
      progressBarFill.style.width = '8%';
      progressStatusText.textContent = i18n.initializing || 'Initializing WebAssembly FFmpeg Engine...';

      const startTime = performance.now();
      const timerInterval = window.setInterval(() => {
        const sec = ((performance.now() - startTime) / 1000).toFixed(1);
        progressElapsedVal.textContent = `${sec}s`;
      }, 100);

      try {
        const ffmpeg = await ensureFFmpegLoaded();

        for (let i = 0; i < fileQueue.length; i++) {
          const item = fileQueue[i];
          const baseName = item.file.name.replace(/\.[^/.]+$/, '');
          const inExt = item.file.name.split('.').pop() || 'mkv';
          const safeInName = `input_${i}.${inExt}`;
          const safeOutName = `output_${i}.${currentOutExt}`;
          const finalDownloadName = `${baseName}.${currentOutExt}`;

          progressFilenameText.textContent = `${item.file.name} (${i + 1}/${fileQueue.length})`;
          progressStatusText.textContent =
            requestedEngineMode === 'remux' ? i18n.remuxing : i18n.transcoding;
          progressSpeedVal.textContent = requestedEngineMode === 'remux' ? '35x–60x (Copy)' : '2.5x (H.264)';

          await ffmpeg.writeFile(safeInName, await fetchFile(item.file));

          let usedEngineMode: 'remux' | 'transcode' = requestedEngineMode;
          const primaryArgs = buildFFmpegArgs(safeInName, safeOutName, currentFormatMode, requestedEngineMode);
          ffmpegLiveLog.textContent = `ffmpeg ${primaryArgs.join(' ')}`;

          let exitCode = await ffmpeg.exec(primaryArgs);

          // If lossless remux failed (e.g., VP8/VP9/AV1 inside container incompatible with MP4 -c copy), fallback to H.264/AAC
          if (exitCode !== 0 && requestedEngineMode === 'remux') {
            usedEngineMode = 'transcode';
            progressStatusText.textContent =
              i18n.fallbackNotice || 'Codec requires universal H.264/AAC transcoding — switching automatically...';
            const fallbackArgs = buildFFmpegArgs(safeInName, safeOutName, currentFormatMode, 'transcode');
            ffmpegLiveLog.textContent = `ffmpeg ${fallbackArgs.join(' ')}`;
            exitCode = await ffmpeg.exec(fallbackArgs);
          }

          const data = await ffmpeg.readFile(safeOutName);
          const uint8 = data instanceof Uint8Array ? data : new TextEncoder().encode(String(data));
          const outBlob = new Blob([uint8.buffer], { type: currentMime });
          const outUrl = URL.createObjectURL(outBlob);

          convertedOutputs.push({
            name: finalDownloadName,
            url: outUrl,
            size: outBlob.size,
            originalName: item.file.name,
            originalSize: item.file.size,
            mime: currentMime,
            usedMode: usedEngineMode === 'remux' ? i18n.modeRemux : i18n.modeTranscode,
          });

          try {
            await ffmpeg.deleteFile(safeInName);
            await ffmpeg.deleteFile(safeOutName);
          } catch {}
        }

        clearInterval(timerInterval);
        const totalSeconds = ((performance.now() - startTime) / 1000).toFixed(2);

        progressPercentNumber.textContent = '100%';
        progressBarFill.style.width = '100%';

        // Populate Step 4 Preview & Download
        const primaryOut = convertedOutputs[0];
        if (primaryOut) {
          if (currentOutExt === 'mp3') {
            videoPreview.classList.add('hidden');
            audioPreview.classList.remove('hidden');
            audioPreview.src = primaryOut.url;
          } else {
            audioPreview.classList.add('hidden');
            videoPreview.classList.remove('hidden');
            videoPreview.src = primaryOut.url;
          }

          downloadLink.href = primaryOut.url;
          downloadLink.download = primaryOut.name;

          statOrigSize.textContent = formatBytes(primaryOut.originalSize);
          statOutSize.textContent = formatBytes(primaryOut.size);
          statElapsed.textContent = `${totalSeconds}s`;
          statEngineMode.textContent = primaryOut.usedMode;
        }

        // Populate Batch Download List if multiple files
        if (convertedOutputs.length > 1) {
          batchResultsContainer.classList.remove('hidden');
          batchResultsList.innerHTML = '';
          convertedOutputs.forEach((out) => {
            const li = document.createElement('li');
            li.className = 'flex items-center justify-between rounded-xl border border-borderTheme bg-bgWorkspace px-3.5 py-2 text-sm';
            li.innerHTML = `
              <span class="truncate font-bold text-textPrimary">${out.name} (${formatBytes(out.size)})</span>
              <a href="${out.url}" download="${out.name}" class="rounded-lg bg-azure px-3 py-1 text-xs font-extrabold text-white hover:bg-blue-600">Download</a>
            `;
            batchResultsList.appendChild(li);
          });
        } else {
          batchResultsContainer.classList.add('hidden');
        }

        showStep(4);
      } catch (err) {
        clearInterval(timerInterval);
        console.error('Conversion error:', err);
        alert('Browser conversion encountered an error. Please try choosing "Re-encode Video (H.264/AAC)".');
        showStep(2);
      }
    });

    // Reset to Convert Another Video
    convertAnotherBtn.addEventListener('click', () => {
      videoPreview.pause();
      videoPreview.removeAttribute('src');
      audioPreview.pause();
      audioPreview.removeAttribute('src');
      fileQueue = [];
      showStep(1);
    });
  }
</script>
