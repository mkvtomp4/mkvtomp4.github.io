---
import { useTranslations, getLocalizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  currentPath?: string;
}

const { lang, currentPath = '' } = Astro.props;
const t = useTranslations(lang);
const homeHref = getLocalizedPath(lang, currentPath);

const faqIndices = ['1', '2', '3', '4', '5', '6', '7', '8'] as const;

const secondaryFormatButtons = [
  { mode: 'mp4-mkv', label: t('mode.mp4_mkv'), keyword: 'MP4 to MKV Converter' },
  { mode: 'webm-mp4', label: t('mode.webm_mp4'), keyword: 'WebM to MP4' },
  { mode: 'mkv-avi', label: t('mode.mkv_avi'), keyword: 'MKV to AVI' },
  { mode: 'mkv-mp3', label: t('mode.mkv_mp3'), keyword: 'MKV to MP3' },
] as const;
---

<div class="mx-auto max-w-6xl px-4 pb-20 pt-6 sm:px-6 lg:px-8 space-y-20">
  <!-- Semantic Breadcrumb Immediately Below First-Fold Hero Workspace -->
  <nav
    aria-label={t('breadcrumb.aria')}
    class="flex items-center justify-between rounded-2xl border border-borderTheme bg-bgSurface px-4 py-3 text-sm font-semibold text-textSecondary shadow-sm"
  >
    <ol class="flex flex-wrap items-center gap-2">
      <li class="flex items-center gap-2">
        <a
          href={homeHref}
          class="flex items-center gap-1.5 text-textPrimary transition hover:text-azure"
        >
          <svg
            class="h-4 w-4 text-azure"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>{t('breadcrumb.home')}</span>
        </a>
      </li>
      <li aria-hidden="true" class="text-borderTheme">/</li>
      <li aria-current="page" class="font-extrabold text-azure">
        {t('breadcrumb.converter')}
      </li>
    </ol>
    <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-pillBadge px-3 py-1 text-xs font-extrabold text-textPrimary">
      <span class="h-2 w-2 rounded-full bg-azure"></span>
      FFmpeg.wasm v0.12 • SharedArrayBuffer Ready
    </span>
  </nav>

  <!-- SECTION 1: 3-Step How-To Guide -->
  <section aria-labelledby="howto-heading" class="scroll-mt-20">
    <div class="text-center max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-2 rounded-full bg-pillBadge px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider text-textPrimary">
        {t('howto.badge')}
      </span>
      <h2
        id="howto-heading"
        class="mt-3 font-display text-2xl font-extrabold tracking-tight text-textPrimary sm:text-3xl md:text-4xl"
      >
        {t('howto.title')}
      </h2>
      <p class="mt-3 text-base font-medium text-textSecondary sm:text-lg">
        {t('howto.subtitle')}
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      <!-- Step 1 Card -->
      <article class="relative flex flex-col rounded-3xl border-2 border-borderTheme bg-bgSurface p-6 sm:p-7 shadow-workspace transition-transform duration-200 hover:-translate-y-1">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-azure text-white shadow-md">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </div>
        <h3 class="font-display text-xl font-extrabold text-textPrimary">
          {t('howto.step1.title')}
        </h3>
        <p class="mt-2.5 text-base leading-relaxed text-textSecondary">
          {t('howto.step1.desc')}
        </p>
      </article>

      <!-- Step 2 Card -->
      <article class="relative flex flex-col rounded-3xl border-2 border-borderTheme bg-bgSurface p-6 sm:p-7 shadow-workspace transition-transform duration-200 hover:-translate-y-1">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-azure text-white shadow-md">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3 class="font-display text-xl font-extrabold text-textPrimary">
          {t('howto.step2.title')}
        </h3>
        <p class="mt-2.5 text-base leading-relaxed text-textSecondary">
          {t('howto.step2.desc')}
        </p>
      </article>

      <!-- Step 3 Card -->
      <article class="relative flex flex-col rounded-3xl border-2 border-borderTheme bg-bgSurface p-6 sm:p-7 shadow-workspace transition-transform duration-200 hover:-translate-y-1">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-azure text-white shadow-md">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        <h3 class="font-display text-xl font-extrabold text-textPrimary">
          {t('howto.step3.title')}
        </h3>
        <p class="mt-2.5 text-base leading-relaxed text-textSecondary">
          {t('howto.step3.desc')}
        </p>
      </article>
    </div>
  </section>

  <!-- SECTION 2: Desktop Software & Cloud Alternative Comparison Matrix -->
  <section aria-labelledby="comparison-heading" class="scroll-mt-20">
    <div class="rounded-[2rem] border-2 border-borderTheme bg-bgSurface p-6 sm:p-9 shadow-workspace">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-pillBadge px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider text-textPrimary">
          {t('comparison.badge')}
        </span>
        <h2
          id="comparison-heading"
          class="mt-3 font-display text-2xl font-extrabold tracking-tight text-textPrimary sm:text-3xl"
        >
          {t('comparison.title')}
        </h2>
        <p class="mt-2.5 text-base font-medium text-textSecondary">
          {t('comparison.subtitle')}
        </p>
      </div>

      <div class="mt-7 overflow-x-auto">
        <table class="w-full min-w-[780px] text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-borderTheme text-xs sm:text-sm font-extrabold uppercase tracking-wider text-textSecondary">
              <th scope="col" class="py-4 pr-4">{t('comparison.col.feature')}</th>
              <th scope="col" class="py-4 px-4 rounded-t-2xl bg-pillBadge/45 text-azure">{t('comparison.col.remux')}</th>
              <th scope="col" class="py-4 px-4">{t('comparison.col.handbrake')}</th>
              <th scope="col" class="py-4 px-4">{t('comparison.col.vlc')}</th>
              <th scope="col" class="py-4 px-4">{t('comparison.col.obs')}</th>
              <th scope="col" class="py-4 pl-4">{t('comparison.col.cloud')}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-borderTheme text-sm sm:text-base font-medium">
            <tr>
              <th scope="row" class="py-4 pr-4 font-extrabold text-textPrimary">{t('comparison.row.speed')}</th>
              <td class="py-4 px-4 bg-pillBadge/25 font-extrabold text-azure">{t('comparison.row.speed.remux')}</td>
              <td class="py-4 px-4 text-textSecondary">{t('comparison.row.speed.handbrake')}</td>
              <td class="py-4 px-4 text-textSecondary">{t('comparison.row.speed.vlc')}</td>
              <td class="py-4 px-4 text-textPrimary">{t('comparison.row.speed.obs')}</td>
              <td class="py-4 pl-4 text-textSecondary">{t('comparison.row.speed.cloud')}</td>
            </tr>
            <tr>
              <th scope="row" class="py-4 pr-4 font-extrabold text-textPrimary">{t('comparison.row.quality')}</th>
              <td class="py-4 px-4 bg-pillBadge/25 font-extrabold text-azure">{t('comparison.row.quality.remux')}</td>
              <td class="py-4 px-4 text-textSecondary">{t('comparison.row.quality.handbrake')}</td>
              <td class="py-4 px-4 text-textSecondary">{t('comparison.row.quality.vlc')}</td>
              <td class="py-4 px-4 text-textPrimary">{t('comparison.row.quality.obs')}</td>
              <td class="py-4 pl-4 text-textSecondary">{t('comparison.row.quality.cloud')}</td>
            </tr>
            <tr>
              <th scope="row" class="py-4 pr-4 font-extrabold text-textPrimary">{t('comparison.row.privacy')}</th>
              <td class="py-4 px-4 bg-pillBadge/25 font-extrabold text-azure">{t('comparison.row.privacy.remux')}</td>
              <td class="py-4 px-4 text-textSecondary">{t('comparison.row.privacy.handbrake')}</td>
              <td class="py-4 px-4 text-textSecondary">{t('comparison.row.privacy.vlc')}</td>
              <td class="py-4 px-4 text-textPrimary">{t('comparison.row.privacy.obs')}</td>
              <td class="py-4 pl-4 text-textSecondary">{t('comparison.row.privacy.cloud')}</td>
            </tr>
            <tr>
              <th scope="row" class="py-4 pr-4 font-extrabold text-textPrimary">{t('comparison.row.mac')}</th>
              <td class="py-4 px-4 rounded-b-2xl bg-pillBadge/25 font-extrabold text-azure">{t('comparison.row.mac.remux')}</td>
              <td class="py-4 px-4 text-textSecondary">{t('comparison.row.mac.handbrake')}</td>
              <td class="py-4 px-4 text-textSecondary">{t('comparison.row.mac.vlc')}</td>
              <td class="py-4 px-4 text-textPrimary">{t('comparison.row.mac.obs')}</td>
              <td class="py-4 pl-4 text-textSecondary">{t('comparison.row.mac.cloud')}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SECTION 3: Educational Deep-Dive Semantic Articles -->
  <section aria-labelledby="edu-heading" class="scroll-mt-20">
    <div class="text-center max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-2 rounded-full bg-pillBadge px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider text-textPrimary">
        {t('edu.badge')}
      </span>
      <h2
        id="edu-heading"
        class="mt-3 font-display text-2xl font-extrabold tracking-tight text-textPrimary sm:text-3xl md:text-4xl"
      >
        {t('edu.title')}
      </h2>
      <p class="mt-3 text-base font-medium text-textSecondary sm:text-lg">
        {t('edu.subtitle')}
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
      <!-- Deep-Dive Card 1: What is an MKV File? -->
      <article class="flex flex-col justify-between rounded-3xl border-2 border-borderTheme bg-bgSurface p-6 sm:p-7 shadow-workspace">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 rounded-xl bg-pillBadge px-3 py-1.5 text-xs font-extrabold text-azure">
            <span>.MKV Container</span>
          </div>
          <h3 class="font-display text-xl font-extrabold text-textPrimary">
            {t('edu.card1.title')}
          </h3>
          <p class="mt-3 text-base leading-relaxed text-textSecondary">
            {t('edu.card1.body')}
          </p>
        </div>
      </article>

      <!-- Deep-Dive Card 2: MKV vs MP4 -->
      <article class="flex flex-col justify-between rounded-3xl border-2 border-borderTheme bg-bgSurface p-6 sm:p-7 shadow-workspace">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 rounded-xl bg-pillBadge px-3 py-1.5 text-xs font-extrabold text-azure">
            <span>MKV vs MP4</span>
          </div>
          <h3 class="font-display text-xl font-extrabold text-textPrimary">
            {t('edu.card2.title')}
          </h3>
          <p class="mt-3 text-base leading-relaxed text-textSecondary">
            {t('edu.card2.body')}
          </p>
        </div>
      </article>

      <!-- Deep-Dive Card 3: What Does Remux MKV to MP4 Mean? -->
      <article class="flex flex-col justify-between rounded-3xl border-2 border-borderTheme bg-bgSurface p-6 sm:p-7 shadow-workspace">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 rounded-xl bg-pillBadge px-3 py-1.5 text-xs font-extrabold text-azure">
            <span>ffmpeg -c copy</span>
          </div>
          <h3 class="font-display text-xl font-extrabold text-textPrimary">
            {t('edu.card3.title')}
          </h3>
          <p class="mt-3 text-base leading-relaxed text-textSecondary">
            {t('edu.card3.body')}
          </p>
        </div>
      </article>
    </div>

    <!-- Secondary Format Expansion Switcher Banner -->
    <div class="mt-8 rounded-3xl border-2 border-borderTheme bg-bgSurface p-6 sm:p-7 shadow-sm">
      <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
        <div class="max-w-2xl">
          <h3 class="font-display text-lg font-extrabold text-textPrimary sm:text-xl">
            {t('edu.formats.title')}
          </h3>
          <p class="mt-1 text-sm font-medium text-textSecondary sm:text-base">
            {t('edu.formats.desc')}
          </p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          {
            secondaryFormatButtons.map((btn) => (
              <button
                type="button"
                data-jump-mode={btn.mode}
                aria-label={`${btn.label} (${btn.keyword})`}
                class="jump-format-btn flex items-center gap-2 rounded-2xl border-2 border-borderTheme bg-bgWorkspace px-4 py-2.5 text-sm font-extrabold text-textPrimary transition hover:border-azure hover:bg-azure hover:text-white"
              >
                <span>{btn.label}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: Interactive FAQ Accordion -->
  <section aria-labelledby="faq-heading" class="scroll-mt-20">
    <div class="text-center max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-2 rounded-full bg-pillBadge px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider text-textPrimary">
        {t('faq.badge')}
      </span>
      <h2
        id="faq-heading"
        class="mt-3 font-display text-2xl font-extrabold tracking-tight text-textPrimary sm:text-3xl md:text-4xl"
      >
        {t('faq.title')}
      </h2>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4">
      {
        faqIndices.map((n) => (
          <details class="group rounded-2xl border-2 border-borderTheme bg-bgSurface p-5 sm:p-6 transition-all duration-200 hover:border-azure open:border-azure">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-extrabold text-textPrimary sm:text-xl">
              <span>{t(`faq.q${n}`)}</span>
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-pillBadge text-azure transition-transform duration-200 group-open:rotate-180"
              >
                ▼
              </span>
            </summary>
            <p class="mt-3.5 text-base leading-relaxed text-textSecondary">
              {t(`faq.a${n}`)}
            </p>
          </details>
        ))
      }
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    const jumpBtns = document.querySelectorAll('[data-jump-mode]');
    jumpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetMode = btn.getAttribute('data-jump-mode');
        if (!targetMode) return;
        const pill = document.querySelector(`[data-mode-pill="${targetMode}"]`);
        if (pill) {
          pill.click();
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  })();
</script>
